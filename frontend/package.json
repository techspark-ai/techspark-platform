    "agents",
    "marketplace",
    "no-code",
    "sme",
    "thailand",
    "react",
    "typescript"
  ],
  "author": "TechSpark AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/techspark-ai/techspark-platform.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/techspark-ai/techspark-platform/issues"
